{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-review-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  // octokit / node の crypto 系を使うため
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORCHESTRATOR",
        "class_name": "ReviewOrchestrator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReviewOrchestrator"]
    }
  ],
  "services": [
    {
      "binding": "RUNNER",
      "service": "pr-review-runner"
    }
  ]
}
