{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-review-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  // octokit / node の crypto 系を使うため
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORCHESTRATOR",
        "class_name": "ReviewOrchestrator"
      },
      {
        "name": "VAULT",
        "class_name": "CredentialVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReviewOrchestrator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CredentialVault"]
    }
  ],
  "services": [
    {
      "binding": "RUNNER",
      "service": "pr-review-runner",
      // サンドボックス操作は HTTP ではなく RPC で呼ぶ
      "entrypoint": "SandboxEntrypoint"
    }
  ],
  // OpenAI は Sign in with ChatGPT の認証情報を /admin から登録するため、ここには無い。
  // それ以外のプロバイダを REVIEW_MODEL で選ぶ場合は、対応する API キーを追加で設定する
  // (GEMINI_API_KEY / ANTHROPIC_API_KEY / OPENCODE_API_KEY / OPENROUTER_API_KEY)。
  "secrets": {
    "required": ["ADMIN_TOKEN", "GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"]
  }
}
